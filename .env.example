# Cadebot Payment Server - cau hinh mau.
# Copy thanh .env roi dien gia tri that. KHONG commit file .env.

# --- Tai khoan nhan tien (VietQR) ---
# BANK_ID: ma BIN cua ngan hang, tra tai https://api.vietqr.io/v2/banks
#   Techcombank 970407 | Vietcombank 970436 | MBBank 970422 | ACB 970416
BANK_ID=970407
ACCOUNT_NO=0000000000
# Ten chu tai khoan viet HOA khong dau. De trong cung duoc, ngan hang tu hien ten.
ACCOUNT_NAME=

# --- Sepay ---
# Lay trong dashboard Sepay. Sepay gui kem header: Authorization: Apikey <key>
# De trong => server tu choi MOI webhook (fail closed).
SEPAY_API_KEY=

# --- Che do phat trien ---
# 1 = bat endpoint /api/payment/mock-pay de test khong can chuyen tien that.
# BAT BUOC dat 0 khi chay that o quan, neu khong ai cung danh dau don la da tra.
ALLOW_MOCK_PAY=1

# --- Tuy chon ---
# DB_PATH=/duong/dan/khac/demo_cafe.db
# ORDER_TTL_MINUTES=10
# TOPPING_PRICE=5000
# PORT=8080
